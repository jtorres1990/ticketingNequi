KEYS PK:HASH,SK:RANGE
ATTRIBUTES GSI1PK:S,GSI1SK:S,GSI2PK:S,GSI2SK:S,GSI3PK:S,GSI3SK:S,GSI4PK:S,GSI4SK:S,PK:S,SK:S
BILLING PAY_PER_REQUEST
INDEX GSI1 GSI1PK:HASH,GSI1SK:RANGE INCLUDE availabilityShards,capacity,createdAt,entityType,eventId,lastProgressAtMs,name,provisioningRepublishCount,provisioningStatus,startsAt,startsAtMs,venue
INDEX GSI2 GSI2PK:HASH,GSI2SK:RANGE INCLUDE row,seat,section,ticketId
INDEX GSI3 GSI3PK:HASH,GSI3SK:RANGE KEYS_ONLY -
INDEX GSI4 GSI4PK:HASH,GSI4SK:RANGE KEYS_ONLY -
TTL ENABLED ttl
