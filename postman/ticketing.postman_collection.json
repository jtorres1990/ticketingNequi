    {
      "name": "1. Eventos (ADMIN)",
      "item": [
        {
          "name": "Crear evento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{eventIdempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "description": "API-001. Crea el Event en PROVISIONING y encola su aprovisionamiento. 202 con Location.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Concierto de demostraci\\u00f3n\",\n  \"venue\": \"Arena local\",\n  \"startsAt\": \"{{eventStartsAt}}\",\n  \"capacity\": 22,\n  \"inventory\": {\n    \"sections\": [\n      {\n        \"code\": \"A\",\n        \"rows\": [\n          {\n            \"label\": \"1\",\n            \"seats\": 10\n          },\n          {\n            \"label\": \"2\",\n            \"seats\": 10\n          }\n        ]\n      },\n      {\n        \"code\": \"VIP\",\n        \"rows\": [\n          {\n            \"label\": \"1\",\n            \"seats\": 2\n          }\n        ]\n      }\n    ],\n    \"complimentary\": [\n      {\n        \"section\": \"VIP\",\n        \"row\": \"1\",\n        \"fromSeat\": 1,\n        \"toSeat\": 2\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('eventIdempotencyKey', 'evt-' + pm.variables.replaceIn('{{$guid}}'));",
                  "const d = new Date(Date.now() + 30 * 24 * 3600 * 1000);",
                  "pm.collectionVariables.set('eventStartsAt', d.toISOString().replace(/\\.\\d{3}Z$/, 'Z'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 aceptado'.trim(), () => pm.response.to.have.status(202));",
                  "pm.test('Location presente', () => pm.response.to.have.header('Location'));",
                  "pm.collectionVariables.set('eventId', pm.response.json().eventId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear evento - repetición idempotente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{eventIdempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "description": "Misma Idempotency-Key y mismo contenido: 200 con Idempotency-Replayed: true y el mismo eventId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Concierto de demostraci\\u00f3n\",\n  \"venue\": \"Arena local\",\n  \"startsAt\": \"{{eventStartsAt}}\",\n  \"capacity\": 22,\n  \"inventory\": {\n    \"sections\": [\n      {\n        \"code\": \"A\",\n        \"rows\": [\n          {\n            \"label\": \"1\",\n            \"seats\": 10\n          },\n          {\n            \"label\": \"2\",\n            \"seats\": 10\n          }\n        ]\n      },\n      {\n        \"code\": \"VIP\",\n        \"rows\": [\n          {\n            \"label\": \"1\",\n            \"seats\": 2\n          }\n        ]\n      }\n    ],\n    \"complimentary\": [\n      {\n        \"section\": \"VIP\",\n        \"row\": \"1\",\n        \"fromSeat\": 1,\n        \"toSeat\": 2\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 repetición'.trim(), () => pm.response.to.have.status(200));",
                  "pm.test('Idempotency-Replayed: true', () => pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('true'));",
                  "pm.test('mismo eventId', () => pm.expect(pm.response.json().eventId).to.eql(pm.collectionVariables.get('eventId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Estado de aprovisionamiento (espera ENABLED)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/provisioning",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "provisioning"
              ]
            },
            "description": "API-002. Repite la consulta hasta ENABLED o FAILED (máximo 30 intentos en el Runner)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 '.trim(), () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const done = [\"ENABLED\"].includes(body.provisioningStatus);",
                  "const n = Number(pm.collectionVariables.get('provisioningPolls') || 0);",
                  "if (!done && n < 30) {",
                  "  pm.collectionVariables.set('provisioningPolls', n + 1);",
                  "  setTimeout(() => {}, 1000);",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.set('provisioningPolls', 0);",
                  "  pm.test('Event ENABLED', () => pm.expect(body.provisioningStatus).to.be.oneOf([\"ENABLED\"]));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Catálogo (ADMIN o CUSTOMER)",
      "item": [
        {
          "name": "Listar eventos futuros",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerAToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "API-003. Events ENABLED futuros ordenados por fecha; incluye soldOut."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 '.trim(), () => pm.response.to.have.status(200));",
                  "pm.test('incluye el evento creado', () => pm.expect(JSON.stringify(pm.response.json())).to.include(pm.collectionVariables.get('eventId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Disponibilidad del evento",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerAToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/availability?pageSize=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "availability"
              ],
              "query": [
                {
                  "key": "pageSize",
                  "value": "50"
                }
              ]
            },
            "description": "API-004. Recuento de Tickets AVAILABLE y una página de Tickets."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 '.trim(), () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Disponibilidad filtrada por sección",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerAToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/availability?section=A&pageSize=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "availability"
              ],
              "query": [
                {
                  "key": "section",
                  "value": "A"
                },
                {
                  "key": "pageSize",
                  "value": "5"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 '.trim(), () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Compra y Order (CUSTOMER)",
      "item": [
        {
          "name": "Iniciar compra",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerAToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{purchaseIdempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "API-005. Reserva atómica de 1 a 10 Tickets; crea la Order en CREATED. 201 con Location.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"ticketIds\": [\n    \"A-1-1\",\n    \"A-1-2\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('purchaseIdempotencyKey', 'ord-' + pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 creada'.trim(), () => pm.response.to.have.status(201));",
                  "pm.test('status CREATED', () => pm.expect(pm.response.json().status).to.eql('CREATED'));",
                  "pm.collectionVariables.set('orderId', pm.response.json().orderId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar compra - repetición idempotente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerAToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{purchaseIdempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"ticketIds\": [\n    \"A-1-1\",\n    \"A-1-2\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 repetición'.trim(), () => pm.response.to.have.status(200));",
                  "pm.test('Idempotency-Replayed: true', () => pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('true'));",
                  "pm.test('misma Order', () => pm.expect(pm.response.json().orderId).to.eql(pm.collectionVariables.get('orderId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar Order (espera estado final)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerAToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "API-006. Repite hasta CONFIRMED, FAILED o EXPIRED (máximo 30 intentos en el Runner)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 '.trim(), () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const done = [\"CONFIRMED\", \"FAILED\", \"EXPIRED\"].includes(body.status);",
                  "const n = Number(pm.collectionVariables.get('orderPolls') || 0);",
                  "if (!done && n < 30) {",
                  "  pm.collectionVariables.set('orderPolls', n + 1);",
                  "  setTimeout(() => {}, 1000);",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.set('orderPolls', 0);",
                  "  pm.test('Order en estado final', () => pm.expect(body.status).to.be.oneOf([\"CONFIRMED\", \"FAILED\", \"EXPIRED\"]));",
                  "  pm.test('Order CONFIRMED', () => pm.expect(body.status).to.eql('CONFIRMED'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Disponibilidad tras la venta",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerAToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/availability?section=A&pageSize=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "availability"
              ],
              "query": [
                {
                  "key": "section",
                  "value": "A"
                },
                {
                  "key": "pageSize",
                  "value": "50"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 '.trim(), () => pm.response.to.have.status(200));",
                  "pm.test('A-1-1 ya no está disponible', () => pm.expect(JSON.stringify(pm.response.json())).to.not.include('\"A-1-1\"'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Casos de error",
      "item": [
        {
          "name": "Sin token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 '.trim(), () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Identidad sin grupos → 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{noGroupsToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 '.trim(), () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "CUSTOMER crea evento → 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerAToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "evt-forbidden-{{$timestamp}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "body": {
              "mode": "raw",
