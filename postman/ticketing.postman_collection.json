                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "identity",
                  "value": "admin",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{idpUrl}}/token",
              "host": [
                "{{idpUrl}}"
              ],
              "path": [
                "token"
              ]
            },
            "description": "Access token RS256 de la identidad `admin` emitido por local-idp (ADR-033)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 token emitido', () => pm.response.to.have.status(200));",
