# -----------------------------------------------------------------------------
# Ticketing Event Processing Platform - local environment (example)
#
# Copy to .env (ignored by Git) and adjust. EVERY value below is FICTITIOUS and
# valid only against the local emulators and mocks of this Compose project.
# Never put real credentials, tokens or keys in this file (ADR-032, ADR-036).
# -----------------------------------------------------------------------------

# --- Fictitious AWS credentials, used only against dynamodb-local and localstack.
#     DynamoDB Local 3.x accepts only letters and digits in the access key id.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=fictitiousLocalAccessKey
AWS_SECRET_ACCESS_KEY=fictitiousLocalSecretKey

# --- Physical resource names created by infra-init (defaults = logical names of
#     data model v2 2.1 and messaging v2 1)
TICKETING_TABLE_NAME=ticketing
ORDERS_QUEUE_NAME=ticketing-orders
ORDERS_DLQ_NAME=ticketing-orders-dlq
PROVISIONING_QUEUE_NAME=ticketing-event-provisioning
PROVISIONING_DLQ_NAME=ticketing-event-provisioning-dlq

# --- Host ports, always bound to 127.0.0.1 (PLAT-IV-008). Container ports are fixed.
#     If a port is busy on your machine, change only the host side here
#     (example: PAYMENT_MOCK_HOST_PORT=18090).
DYNAMODB_HOST_PORT=8000
LOCALSTACK_HOST_PORT=4566
LOCAL_IDP_HOST_PORT=9000
PAYMENT_MOCK_HOST_PORT=8090
# ticketing-api: public API (/api/v1) and management port (local only). The worker publishes nothing.
TICKETING_API_HOST_PORT=8080
TICKETING_API_MANAGEMENT_HOST_PORT=8081

# --- Payment Mock API key (secret in real .env files; REQUIRED, Compose fails without it)
PAYMENT_MOCK_API_KEY=fictitious-local-payment-mock-key-change-me

# --- Local identity provider (ADR-033, PLAT-IV-003). Local profile only, never AWS.
LOCAL_IDP_ISSUER=http://local-idp:9000
LOCAL_IDP_CLIENT_ID=ticketing-local-client
LOCAL_IDP_DEFAULT_TTL_SECONDS=3600
LOCAL_IDP_MAX_TTL_SECONDS=86400

# --- ticketing-worker identifier (optional). Empty = "worker-<random>" per process.
#TICKETING_WORKER_ID=

# --- Load profile token batch (PLAT-IV-009). TTL must exceed test duration + ramp.
LOAD_TOKEN_COUNT=1200
LOAD_TOKEN_TTL_SECONDS=7200
